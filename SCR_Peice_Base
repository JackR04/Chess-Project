// Heal piece and spawn particles
public void Heal(float healAmount,bool spawnParticles)
{
    if (spawnParticles)
    {
        
        healParticles = Instantiate(teamHealthManager.healParticles, transform.position + new Vector3(0, 1, 0), Quaternion.identity, gameObject.transform);
        if (healParticles.GetComponent<VisualEffect>() != null)
        {
            healParticles.GetComponent<VisualEffect>().Play();
        }
    }

    CurrentHealth += healAmount;

}
// Heal all friendly peices in diagonals from bishop
private IEnumerator BishopAbliity(float healamount)
{

    List<SCR_Peice_Base> friendlyPieces = GetFriendlyPiecesInRange();

    if (friendlyPieces != null)
    {
        foreach (SCR_Peice_Base f_Piece in friendlyPieces)
        {
            Vector2Int tilePos = f_Piece.currentTile;
            GameObject newGlow = Instantiate(teamHealthManager.greenGlow, new Vector3(tilePos.x, -0.45f, tilePos.y), Quaternion.identity);
            teamHealthManager.currentGlows.Add(newGlow);
            f_Piece.Heal(healamount, true);
            Debug.Log("Healed " + f_Piece.name + " for " + healamount);
        }
    }

    action = action.idle;
    yield return new WaitForEndOfFrame();

}
